# Logistics project server environment only. Replace placeholders.
FRAPPE_URL=https://YOUR_ERPNEXT_HOST
FRAPPE_API_KEY=YOUR_INTEGRATION_USER_API_KEY
FRAPPE_API_SECRET=YOUR_INTEGRATION_USER_API_SECRET
FRAPPE_EWAYBILL_GENERATE_METHOD=jaya_integration.api.ewaybill.generate
FRAPPE_EWAYBILL_FETCH_METHOD=jaya_integration.api.ewaybill.fetch
FRAPPE_EWAYBILL_STATUS_METHOD=jaya_integration.api.ewaybill.status

# Prepare/preview does not generate a statutory bill.
FRAPPE_EWAYBILL_PREVIEW_METHOD=jaya_integration.api.ewaybill.preview
# Keep disabled until your live-site deployment checks are complete.
FRAPPE_EWAYBILL_ENABLED=false
