# Copy this file to android/keystore.properties on the controlled release machine.
# Do not commit the copy, the keystore, passwords, or the signing alias.
# Use forward slashes even on Windows.
storeFile=C:/secure-release-keys/jaya-logistics-driver-release.jks
storePassword=replace-with-secure-store-value
keyAlias=jaya-logistics-driver
keyPassword=replace-with-secure-store-value
